@model WebBanHang.Models.Order
@using WebBanHang.Models
@using WebBanHang.Session

@{
    ViewData["Title"] = "Thanh toán đơn hàng";
    var cart = ViewBag.Cart as List<CartItem> ?? new List<CartItem>();
    var discountAmount = ViewBag.DiscountAmount != null ? (int)ViewBag.DiscountAmount : 0;
    var subtotal = cart.Sum(c => c.Price * c.Quantity);
    var total = subtotal - discountAmount;
    if (total < 0) total = 0;
}

<div class="container my-5">
    <div class="row">
        <!-- Cột thông tin khách hàng -->
        <div class="col-md-7 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-person-lines-fill me-2"></i>Thông tin nhận Acc & Thanh toán</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Checkout" method="post" id="checkoutForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <h6 class="fw-bold text-dark mb-3">1. Thông tin liên hệ</h6>
                        <div class="mb-3">
                            <label asp-for="CustomerName" class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input asp-for="CustomerName" class="form-control" placeholder="Nhập tên của bạn" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold">Số điện thoại (Zalo) <span class="text-danger">*</span></label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">Email nhận Acc <span class="text-danger">*</span></label>
                                <input asp-for="Email" class="form-control" placeholder="Nhập email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-semibold">Ghi chú thêm (Tùy chọn)</label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Ghi chú thêm nếu có..."></textarea>
                        </div>

                        <hr class="my-4" />
                        
                        <h6 class="fw-bold text-dark mb-3">2. Phương thức thanh toán</h6>
                        <div class="mb-4">
                            <div class="form-check border rounded p-3 mb-2 bg-light">
                                <input class="form-check-input ms-1 me-2" type="radio" asp-for="PaymentMethod" value="Chuyển khoản" id="payTransfer" checked>
                                <label class="form-check-label fw-semibold d-flex align-items-center" for="payTransfer">
                                    <i class="bi bi-bank fs-4 text-primary me-3"></i> Chuyển khoản ngân hàng (Khuyên dùng)
                                </label>
                            </div>
                            <div class="form-check border rounded p-3 mb-2 bg-light">
                                <input class="form-check-input ms-1 me-2" type="radio" asp-for="PaymentMethod" value="Ví điện tử" id="payWallet">
                                <label class="form-check-label fw-semibold d-flex align-items-center" for="payWallet">
                                    <i class="bi bi-wallet2 fs-4 text-success me-3"></i> Ví điện tử (Momo, ZaloPay, VNPay)
                                </label>
                            </div>
                            <div class="form-check border rounded p-3 bg-light">
                                <input class="form-check-input ms-1 me-2" type="radio" asp-for="PaymentMethod" value="Thẻ tín dụng" id="payCredit">
                                <label class="form-check-label fw-semibold d-flex align-items-center" for="payCredit">
                                    <i class="bi bi-credit-card-2-front fs-4 text-warning me-3"></i> Thẻ tín dụng / Thẻ ghi nợ (Visa, Mastercard)
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary fw-bold w-100 py-3 fs-5 mt-3 shadow">
                            <i class="bi bi-check2-circle me-2"></i> Đặt mua ngay
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Cột tóm tắt đơn hàng -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-header bg-light py-3 border-bottom-0">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-receipt me-2"></i>Tóm tắt đơn hàng</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in cart)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.ProductName" style="width: 50px; height: 50px; object-fit: contain;" class="rounded border me-3" />
                                    }
                                    <div>
                                        <h6 class="my-0 fw-bold">@item.ProductName</h6>
                                        <small class="text-muted">SL: @item.Quantity</small>
                                    </div>
                                </div>
                                <span class="text-danger fw-semibold">@((item.Price * item.Quantity).ToString("N0"))đ</span>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card-footer bg-white p-4 border-top">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tổng tiền hàng:</span>
                        <strong class="text-dark">@subtotal.ToString("N0")đ</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Phí giao hàng:</span>
                        <strong class="text-dark">Giao Online (Miễn phí)</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Giảm giá:</span>
                        <strong class="text-success">-@discountAmount.ToString("N0")đ</strong>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="fw-bold fs-5">Tổng thanh toán:</span>
                        <strong class="text-danger fs-3">@total.ToString("N0")đ</strong>
                    </div>
                </div>
            </div>
            
            <div class="alert alert-warning mt-4 shadow-sm border-0">
                <i class="bi bi-shield-lock-fill me-2 text-warning fs-5 align-middle"></i>
                <small>Thông tin của bạn sẽ được bảo mật tuyệt đối. Chúng tôi sẽ gửi thông tin tài khoản qua Email hoặc Zalo của bạn ngay sau khi xác nhận thanh toán.</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
