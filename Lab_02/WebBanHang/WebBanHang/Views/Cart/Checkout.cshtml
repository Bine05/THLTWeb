@model WebBanHang.Models.Order
@using WebBanHang.Models
@using WebBanHang.Session

@{
    ViewData["Title"] = "Thanh toán đơn hàng";
    var cart = Context.Session.GetObjectFromJson<List<CartItem>>("Cart") ?? new List<CartItem>();
}

<div class="container my-5">
    <div class="row">
        <!-- Cột thông tin khách hàng -->
        <div class="col-md-7 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-person-lines-fill me-2"></i>Thông tin nhận Acc</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Checkout" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CustomerName" class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input asp-for="CustomerName" class="form-control" placeholder="Nhập tên của bạn" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold">Số điện thoại (Zalo) <span class="text-danger">*</span></label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">Email nhận Acc <span class="text-danger">*</span></label>
                                <input asp-for="Email" class="form-control" placeholder="Nhập email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-semibold">Ghi chú thêm (Tùy chọn)</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Ghi chú thêm nếu có..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary fw-bold w-100 py-2 fs-5">
                            <i class="bi bi-check2-circle me-2"></i> Xác nhận thanh toán
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Cột tóm tắt đơn hàng -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3 border-bottom-0">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-receipt me-2"></i>Tóm tắt đơn hàng</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in cart)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.ProductName" style="width: 50px; height: 50px; object-fit: contain;" class="rounded border me-3" />
                                    }
                                    <div>
                                        <h6 class="my-0 fw-bold">@item.ProductName</h6>
                                        <small class="text-muted">SL: @item.Quantity</small>
                                    </div>
                                </div>
                                <span class="text-danger fw-semibold">@((item.Price * item.Quantity).ToString("N0"))đ</span>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card-footer bg-white p-3 border-top">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-5">Tổng thanh toán:</span>
                        <strong class="text-danger fs-4">@cart.Sum(c => c.Price * c.Quantity).ToString("N0")đ</strong>
                    </div>
                </div>
            </div>
            
            <div class="alert alert-warning mt-4 shadow-sm border-0">
                <i class="bi bi-shield-lock-fill me-2 text-warning fs-5 align-middle"></i>
                <small>Thông tin của bạn sẽ được bảo mật tuyệt đối. Chúng tôi sẽ gửi thông tin tài khoản qua Email hoặc Zalo của bạn ngay sau khi xác nhận thanh toán.</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
