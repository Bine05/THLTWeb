@model IEnumerable<WebBanHang.Models.Order>

@{
    ViewData["Title"] = "Lịch sử mua hàng";
}

<div class="container my-5">
    <!-- Phần 1: Điểm thưởng & Hạng thành viên -->
    <div class="card shadow-sm border-0 mb-5 bg-light">
        <div class="card-body p-4 text-center">
            <h3 class="mb-3 fw-bold">Thông tin thành viên</h3>
            <div class="d-flex justify-content-center align-items-center gap-5">
                <div>
                    <h5 class="text-muted mb-1">Điểm thưởng tích lũy</h5>
                    <h2 class="text-primary fw-bold mb-0"><i class="bi bi-star-fill text-warning me-2"></i>@ViewBag.RewardPoints điểm</h2>
                </div>
                <div class="border-start ps-5">
                    <h5 class="text-muted mb-1">Hạng thành viên hiện tại</h5>
                    <h2 class="@ViewBag.TierColor fw-bold mb-0"><i class="bi bi-award-fill me-2"></i>Hạng @ViewBag.MembershipTier</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Phần 2: Danh sách đơn hàng -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark"><i class="bi bi-clock-history me-2"></i>Lịch sử mua hàng của bạn</h3>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm p-5">
            <i class="bi bi-bag-x display-1 text-muted mb-3"></i>
            <h4 class="mt-3">Bạn chưa có đơn hàng nào!</h4>
            <p class="mb-0">Hãy quay lại trang sản phẩm để mua sắm và tích lũy điểm thưởng nhé.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in Model)
            {
                <div class="col-12 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                            <div>
                                <span class="badge bg-primary fs-6 me-2">Mã ĐH: #@order.Id</span>
                                <span class="text-muted"><i class="bi bi-calendar-event me-1"></i> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div>
                                @if (order.OrderStatus == "Đã xác nhận")
                                {
                                    <span class="badge bg-secondary">@order.OrderStatus</span>
                                }
                                else if (order.OrderStatus == "Hoàn thành")
                                {
                                    <span class="badge bg-success">@order.OrderStatus</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">@order.OrderStatus</span>
                                }
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-hover align-middle mb-0">
                                <tbody>
                                    @foreach (var detail in order.OrderDetails)
                                    {
                                        <tr>
                                            <td class="ps-4 py-3" style="width: 60%;">
                                                <div class="d-flex align-items-center">
                                                    @if (detail.Product != null && !string.IsNullOrEmpty(detail.Product.ImageUrl))
                                                    {
                                                        <img src="@detail.Product.ImageUrl" class="rounded border" alt="@detail.Product.Name" style="width: 50px; height: 50px; object-fit: contain;" />
                                                    }
                                                    <div class="ms-3">
                                                        <h6 class="mb-0 fw-bold">@(detail.Product?.Name ?? "Sản phẩm không xác định")</h6>
                                                        <small class="text-muted">Đơn giá: @detail.Price.ToString("N0")đ x @detail.Quantity</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-end text-danger fw-bold pe-4" style="width: 20%;">
                                                @((detail.Price * detail.Quantity).ToString("N0"))đ
                                            </td>
                                            <td class="text-end pe-4" style="width: 20%;">
                                                <!-- Nút Đặt lại (Re-order) -->
                                                <form asp-controller="CustomerOrder" asp-action="ReOrder" method="post" class="d-inline">
                                                    <input type="hidden" name="productId" value="@detail.ProductId" />
                                                    <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                                        <i class="bi bi-arrow-repeat me-1"></i> Mua lại
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer bg-light py-3 px-4 d-flex justify-content-between align-items-center border-top">
                            <div>
                                <span class="text-muted">Tổng tiền:</span>
                                <strong class="text-danger fs-5 ms-2">@order.TotalAmount.ToString("N0")đ</strong>
                            </div>
                            <a asp-controller="CustomerOrder" asp-action="Details" asp-route-id="@order.Id" class="btn btn-dark btn-sm px-4">
                                Xem chi tiết hóa đơn <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
