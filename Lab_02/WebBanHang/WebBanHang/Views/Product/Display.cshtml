@model WebBanHang.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="m-0 fw-bold"><i class="bi bi-info-circle-fill me-2"></i>Chi tiết sản phẩm</h4>
            </div>
            <div class="card-body p-4">
                
                <div class="text-center mb-4">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded shadow-sm" style="max-height: 400px; object-fit: contain;" />
                    }
                </div>

                @if (Model.Images != null && Model.Images.Any())
                {
                    <div class="row mb-4 justify-content-center">
                        <h5 class="fw-bold text-primary mb-3">Các hình ảnh chi tiết khác</h5>
                        <div class="d-flex flex-wrap gap-2 justify-content-center">
                            @foreach (var img in Model.Images)
                            {
                                <img src="@img.Url" alt="Chi tiết @Model.Name" class="img-thumbnail shadow-sm" style="max-height: 120px; object-fit: cover;" />
                            }
                        </div>
                    </div>
                }

                <dl class="row">
                    <dt class="col-sm-4">Tên sản phẩm</dt>
                    <dd class="col-sm-8 fw-bold fs-5">@Model.Name</dd>

                    <dt class="col-sm-4">Giá bán</dt>
                    <dd class="col-sm-8">
                        @if (Model.DiscountPercentage > 0 || Model.DiscountAmount > 0)
                        {
                            <span class="text-muted text-decoration-line-through me-2">@Model.Price.ToString("N0")đ</span>
                            <span class="text-danger fw-bold fs-5">
                                @Model.FinalPrice.ToString("N0")đ
                                @if (Model.DiscountPercentage > 0)
                                {
                                    <span class="badge bg-danger ms-1" style="font-size: 0.75rem; vertical-align: middle;">-@Model.DiscountPercentage%</span>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="text-danger fw-bold fs-5">@Model.Price.ToString("N0")đ</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Danh mục</dt>
                    <dd class="col-sm-8">@(Model.Category?.Name ?? "N/A")</dd>

                    <dt class="col-sm-4">Mô tả</dt>
                    <dd class="col-sm-8" style="white-space: pre-line;">@Model.Description</dd>
                </dl>

                <div class="d-flex gap-2 mt-4 pt-3 border-top">
                    <a asp-action="AddToCart" asp-controller="Product" asp-route-id="@Model.Id" class="btn btn-primary fw-bold flex-grow-1 py-2">
                        <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                    </a>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                        Quay lại
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>