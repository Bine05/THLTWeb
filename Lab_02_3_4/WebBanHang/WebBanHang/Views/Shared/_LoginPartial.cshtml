@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.FullName ?? User.Identity?.Name;

    <li class="nav-item d-flex align-items-center">
        @if (!string.IsNullOrEmpty(currentUser?.AvatarUrl))
        {
            <img src="@currentUser.AvatarUrl" alt="Avatar" class="rounded-circle me-2" style="width: 30px; height: 30px; object-fit: cover;" />
        }
        else
        {
            <img src="https://ui-avatars.com/api/?name=@displayName&background=random" alt="Avatar" class="rounded-circle me-2" style="width: 30px; height: 30px; object-fit: cover;" />
        }
        <a class="nav-link text-white fw-bold hover-opacity p-0" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Xin chào @displayName!</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Product", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link text-white fw-bold hover-opacity" style="border: none; background: none; margin: 0; padding-left: 10px;">Đăng xuất</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-white fw-bold hover-opacity" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white fw-bold hover-opacity" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
    </li>
}
</ul>
