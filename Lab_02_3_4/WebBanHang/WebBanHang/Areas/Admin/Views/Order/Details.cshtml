@model WebBanHang.Models.Order

@{
    ViewData["Title"] = "Chi tiết Đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Chi tiết đơn hàng #@Model.Id</h4>
            <a asp-action="Index" class="btn btn-outline-light btn-sm">Quay lại danh sách</a>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h5 class="fw-bold border-bottom pb-2">Thông tin khách hàng</h5>
                    <p class="mb-1"><strong>Họ tên:</strong> @Model.CustomerName</p>
                    <p class="mb-1"><strong>SĐT:</strong> @Model.PhoneNumber</p>
                    <p class="mb-1"><strong>Email:</strong> @Model.Email</p>
                </div>
                <div class="col-md-6">
                    <h5 class="fw-bold border-bottom pb-2">Thông tin đơn hàng</h5>
                    <p class="mb-1"><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</p>
                    <p class="mb-1"><strong>Ghi chú:</strong> @(string.IsNullOrEmpty(Model.Notes) ? "Không có" : Model.Notes)</p>
                    <p class="mb-1">
                        <strong>Tổng tiền:</strong> 
                        <span class="text-danger fw-bold">@String.Format("{0:N0} đ", Model.TotalAmount)</span>
                    </p>
                </div>
            </div>

            <h5 class="fw-bold border-bottom pb-2">Sản phẩm đã mua</h5>
            <table class="table table-bordered table-striped mt-3">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Hình ảnh</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderDetails)
                    {
                        <tr>
                            <td class="align-middle">@item.Product?.Name</td>
                            <td class="align-middle text-center">
                                @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                {
                                    <img src="@item.Product.ImageUrl" alt="@item.Product.Name" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" />
                                }
                            </td>
                            <td class="align-middle">@String.Format("{0:N0} đ", item.Price)</td>
                            <td class="align-middle text-center">@item.Quantity</td>
                            <td class="align-middle text-danger fw-bold">@String.Format("{0:N0} đ", item.Price * item.Quantity)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
