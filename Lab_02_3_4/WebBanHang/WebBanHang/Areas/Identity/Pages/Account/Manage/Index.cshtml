@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form id="profile-form" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            
            <div class="mb-3 text-center">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover;" />
                }
                else
                {
                    <img src="https://ui-avatars.com/api/?name=@Model.Username&background=random" alt="Avatar" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover;" />
                }
            </div>
            
            <div class="mb-3">
                <label asp-for="Input.AvatarImage" class="form-label"></label>
                <input asp-for="Input.AvatarImage" class="form-control" type="file" accept="image/*" />
                <span asp-validation-for="Input.AvatarImage" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" placeholder="Vui lòng chọn tên đăng nhập." disabled />
                <label asp-for="Username" class="form-label">Tên đăng nhập</label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.FullName" class="form-control" placeholder="Vui lòng nhập họ tên."/>
                <label asp-for="Input.FullName" class="form-label">Họ và tên</label>
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Vui lòng nhập số điện thoại."/>
                <label asp-for="Input.PhoneNumber" class="form-label">Số điện thoại</label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary">Lưu thay đổi</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
