@model IEnumerable<WebBanHang.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary"><i class="bi bi-cart3 me-2"></i>Giỏ hàng của bạn</h2>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary px-4 py-2">
            <i class="bi bi-arrow-left me-1"></i> Tiếp tục mua sắm
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm p-5">
            <i class="bi bi-cart-x display-1 text-muted mb-3"></i>
            <h4 class="mt-3">Giỏ hàng của bạn đang trống!</h4>
            <p class="mb-0">Hãy quay lại trang sản phẩm để chọn thêm món đồ yêu thích nhé.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-4">Sản phẩm</th>
                                <th scope="col" class="text-center">Đơn giá</th>
                                <th scope="col" class="text-center" style="width: 120px;">Số lượng</th>
                                <th scope="col" class="text-end">Thành tiền</th>
                                <th scope="col" class="text-center pe-4">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" class="rounded border" alt="@item.ProductName" style="width: 60px; height: 60px; object-fit: contain; background: #fff;" />
                                            }
                                            else
                                            {
                                                <div class="rounded border d-flex align-items-center justify-content-center bg-light" style="width: 60px; height: 60px;">
                                                    <i class="bi bi-image text-muted"></i>
                                                </div>
                                            }
                                            <div class="ms-3">
                                                <h6 class="mb-0 fw-bold text-dark">@item.ProductName</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center text-danger fw-semibold">
                                        @item.Price.ToString("N0")đ
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary px-3 py-2 fs-6">@item.Quantity</span>
                                    </td>
                                    <td class="text-end text-danger fw-bold fs-5">
                                        @((item.Price * item.Quantity).ToString("N0"))đ
                                    </td>
                                    <td class="text-center pe-4">
                                        <a asp-controller="Cart" asp-action="RemoveFromCart" asp-route-id="@item.ProductId" class="btn btn-outline-danger btn-sm" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold fs-5 py-3">Tổng cộng:</td>
                                <td colspan="2" class="text-end pe-4 text-danger fw-bold fs-4 py-3">
                                    @Model.Sum(x => x.Price * x.Quantity).ToString("N0")đ
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white text-end py-3 px-4 border-top">
                <a asp-controller="Cart" asp-action="Checkout" class="btn btn-primary fw-bold px-5 py-2">
                    <i class="bi bi-credit-card me-2"></i> Tiến hành thanh toán
                </a>
            </div>
        </div>
    }
</div>
