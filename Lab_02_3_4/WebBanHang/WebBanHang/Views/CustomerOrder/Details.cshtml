@model WebBanHang.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
    
    // Logic xác định trạng thái timeline cho hàng Online
    int statusStep = 1;
    if (Model.OrderStatus == "Đang chuẩn bị Acc") statusStep = 2;
    else if (Model.OrderStatus == "Đã gửi qua Email") statusStep = 3;
    else if (Model.OrderStatus == "Hoàn thành") statusStep = 4;
}

<style>
    .bs4-order-tracking {
        margin-bottom: 30px;
        overflow: hidden;
        color: #878788;
        padding-left: 0px;
        margin-top: 30px;
    }
    .bs4-order-tracking li {
        list-style-type: none;
        font-size: 13px;
        width: 25%;
        float: left;
        position: relative;
        font-weight: 400;
        color: #878788;
        text-align: center;
    }
    .bs4-order-tracking li:first-child:before {
        margin-left: 15px !important;
        padding-left: 11px !important;
        text-align: left !important;
    }
    .bs4-order-tracking li:last-child:before {
        margin-right: 5px !important;
        padding-right: 11px !important;
        text-align: right !important;
    }
    .bs4-order-tracking li>div {
        color: #fff;
        width: 29px;
        height: 29px;
        text-align: center;
        line-height: 29px;
        display: block;
        font-size: 12px;
        background: #878788;
        border-radius: 50%;
        margin: auto;
    }
    .bs4-order-tracking li:after {
        content: '';
        width: 150%;
        height: 2px;
        background: #878788;
        position: absolute;
        left: 0%;
        right: 0%;
        top: 15px;
        z-index: -1;
    }
    .bs4-order-tracking li:first-child:after {
        left: 50%;
    }
    .bs4-order-tracking li:last-child:after {
        left: 0% !important;
        width: 50% !important;
    }
    .bs4-order-tracking li.active {
        font-weight: bold;
        color: #000;
    }
    .bs4-order-tracking li.active>div {
        background: #28a745;
    }
    .bs4-order-tracking li.active:after {
        background: #28a745;
    }
</style>

<div class="container my-5">
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <h2 class="fw-bold"><i class="bi bi-file-earmark-text me-2"></i>Chi tiết đơn hàng #@Model.Id</h2>
        <a asp-controller="CustomerOrder" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Trở về lịch sử
        </a>
    </div>

    <!-- Timeline trạng thái đơn hàng (Giao Online) -->
    <div class="card shadow-sm border-0 mb-4 py-4">
        <div class="card-body">
            <h5 class="fw-bold mb-4 text-center">Tiến trình bàn giao Tài khoản (Online)</h5>
            <ul class="bs4-order-tracking">
                <li class="step @(statusStep >= 1 ? "active" : "")">
                    <div><i class="bi bi-check"></i></div>
                    <p class="mt-3">Đã xác nhận</p>
                </li>
                <li class="step @(statusStep >= 2 ? "active" : "")">
                    <div><i class="bi bi-gear"></i></div>
                    <p class="mt-3">Đang chuẩn bị Acc</p>
                </li>
                <li class="step @(statusStep >= 3 ? "active" : "")">
                    <div><i class="bi bi-envelope-check"></i></div>
                    <p class="mt-3">Đã gửi qua Email</p>
                </li>
                <li class="step @(statusStep >= 4 ? "active" : "")">
                    <div><i class="bi bi-star"></i></div>
                    <p class="mt-3">Hoàn thành</p>
                </li>
            </ul>
        </div>
    </div>

    <div class="row">
        <!-- Thông tin đơn hàng & Người nhận -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light py-3 border-bottom-0">
                    <h5 class="mb-0 fw-bold">Thông tin hóa đơn</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2"><span class="text-muted">Ngày đặt hàng:</span> <br> <strong>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</strong></p>
                    <p class="mb-2"><span class="text-muted">Tên người nhận:</span> <br> <strong>@Model.CustomerName</strong></p>
                    <p class="mb-2"><span class="text-muted">Số Zalo (SĐT):</span> <br> <strong>@Model.PhoneNumber</strong></p>
                    <p class="mb-2"><span class="text-muted">Email nhận Acc:</span> <br> <strong>@Model.Email</strong></p>
                    <p class="mb-2"><span class="text-muted">Phương thức thanh toán:</span> <br> <strong class="text-primary">@Model.PaymentMethod</strong></p>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <p class="mb-2"><span class="text-muted">Ghi chú:</span> <br> <em>@Model.Notes</em></p>
                    }
                </div>
            </div>
        </div>

        <!-- Chi tiết sản phẩm -->
        <div class="col-md-8 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light py-3 border-bottom-0">
                    <h5 class="mb-0 fw-bold">Danh sách sản phẩm</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Sản phẩm</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end pe-4">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in Model.OrderDetails)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center">
                                                @if (detail.Product != null && !string.IsNullOrEmpty(detail.Product.ImageUrl))
                                                {
                                                    <img src="@detail.Product.ImageUrl" class="rounded border" alt="@detail.Product.Name" style="width: 50px; height: 50px; object-fit: contain;" />
                                                }
                                                <div class="ms-3">
                                                    <h6 class="mb-0 fw-bold">@(detail.Product?.Name ?? "Sản phẩm không xác định")</h6>
                                                    <small class="text-muted">Đơn giá: @detail.Price.ToString("N0")đ</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">@detail.Quantity</td>
                                        <td class="text-end fw-bold text-danger pe-4">@((detail.Price * detail.Quantity).ToString("N0"))đ</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <td colspan="2" class="text-end text-muted">Giảm giá:</td>
                                    <td class="text-end text-success fw-bold pe-4">-@Model.DiscountAmount.ToString("N0")đ</td>
                                </tr>
                                <tr>
                                    <td colspan="2" class="text-end text-muted fs-5">Tổng thanh toán:</td>
                                    <td class="text-end text-danger fw-bold fs-4 pe-4">@Model.TotalAmount.ToString("N0")đ</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
