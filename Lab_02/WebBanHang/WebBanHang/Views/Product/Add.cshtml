@model WebBanHang.Models.Product
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="m-0 fw-bold"><i class="bi bi-plus-circle-fill me-2"></i>Thêm sản phẩm mới</h4>
            </div>
            <div class="card-body p-4">
                
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["ErrorMessage"]
                    </div>
                }`

                <form asp-action="Add" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3 form-group">
                        <label class="form-label fw-semibold text-dark">Tên sản phẩm</label>
                        <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-group">
                        <label class="form-label fw-semibold text-dark">Giá bán (động)</label>
                        <div class="input-group">
                            <input asp-for="Price" type="number" class="form-control" placeholder="Ví dụ: 15000000" />
                            <span class="input-group-text bg-light">đ</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-group">
                        <label class="form-label fw-semibold text-dark">Danh mục</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                            <option value="">-- Chọn danh mục sản phẩm --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-group">
                        <label class="form-label fw-semibold text-dark">Hình ảnh đại diện</label>
                        <input type="file" name="Image" class="form-control" accept="image/*" />
                    </div>

                    <div class="mb-3 form-group">
                        <label class="form-label fw-semibold text-dark">Các hình ảnh chi tiết khác</label>
                        <input type="file" name="imageUrls" class="form-control" accept="image/*" multiple />
                        <small class="text-muted">Bạn có thể chọn nhiều ảnh cùng lúc.</small>
                    </div>

                    <div class="mb-4 form-group">
                        <label class="form-label fw-semibold text-dark">Mô tả sản phẩm</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập thông tin mô tả chi tiết về sản phẩm..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 pt-2 border-top">
                        <button type="submit" class="btn btn-primary fw-bold flex-grow-1 py-2">
                            <i class="bi bi-check-circle-fill"></i> Lưu sản phẩm

                        </button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                            Quay lại
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}