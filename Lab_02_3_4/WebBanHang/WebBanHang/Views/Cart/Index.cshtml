@model IEnumerable<WebBanHang.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
    var discountAmount = ViewBag.DiscountAmount != null ? (int)ViewBag.DiscountAmount : 0;
    var subtotal = Model?.Sum(x => x.Price * x.Quantity) ?? 0;
    var total = subtotal - discountAmount;
    if (total < 0) total = 0;
    var suggestedProducts = ViewBag.SuggestedProducts as List<WebBanHang.Models.Product>;
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary"><i class="bi bi-cart3 me-2"></i>Giỏ hàng của bạn</h2>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary px-4 py-2">
            <i class="bi bi-arrow-left me-1"></i> Tiếp tục mua sắm
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm p-5">
            <i class="bi bi-cart-x display-1 text-muted mb-3"></i>
            <h4 class="mt-3">Giỏ hàng của bạn đang trống!</h4>
            <p class="mb-0">Hãy quay lại trang sản phẩm để chọn thêm món đồ yêu thích nhé.</p>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Cột trái: Danh sách sản phẩm -->
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="cartTable">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col" class="ps-4">Sản phẩm</th>
                                        <th scope="col" class="text-center">Đơn giá</th>
                                        <th scope="col" class="text-center" style="width: 140px;">Số lượng</th>
                                        <th scope="col" class="text-end">Thành tiền</th>
                                        <th scope="col" class="text-center pe-4">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr id="cart-item-@item.ProductId">
                                            <td class="ps-4 py-3">
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                    {
                                                        <img src="@item.ImageUrl" class="rounded border" alt="@item.ProductName" style="width: 60px; height: 60px; object-fit: contain; background: #fff;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded border d-flex align-items-center justify-content-center bg-light" style="width: 60px; height: 60px;">
                                                            <i class="bi bi-image text-muted"></i>
                                                        </div>
                                                    }
                                                    <div class="ms-3">
                                                        <h6 class="mb-0 fw-bold text-dark">@item.ProductName</h6>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center text-danger fw-semibold">
                                                @item.Price.ToString("N0")đ
                                            </td>
                                            <td class="text-center">
                                                <div class="input-group input-group-sm">
                                                    <button class="btn btn-outline-secondary btn-decrease" type="button" data-id="@item.ProductId">-</button>
                                                    <input type="text" class="form-control text-center input-quantity" value="@item.Quantity" readonly />
                                                    <button class="btn btn-outline-secondary btn-increase" type="button" data-id="@item.ProductId">+</button>
                                                </div>
                                            </td>
                                            <td class="text-end text-danger fw-bold fs-6 item-total" id="item-total-@item.ProductId">
                                                @((item.Price * item.Quantity).ToString("N0"))đ
                                            </td>
                                            <td class="text-center pe-4">
                                                <a asp-controller="Cart" asp-action="RemoveFromCart" asp-route-id="@item.ProductId" class="btn btn-outline-danger btn-sm" title="Xóa">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Tính năng Bán chéo (Cross-selling) -->
                @if (suggestedProducts != null && suggestedProducts.Any())
                {
                    <h4 class="fw-bold text-dark mt-5 mb-3"><i class="bi bi-stars text-warning me-2"></i>Có thể bạn cũng thích</h4>
                    <div class="row row-cols-2 row-cols-md-4 g-3">
                        @foreach(var sp in suggestedProducts)
                        {
                            <div class="col">
                                <div class="card h-100 shadow-sm border-0">
                                    <img src="@sp.ImageUrl" class="card-img-top" alt="@sp.Name" style="height: 120px; object-fit: contain; padding: 10px;" onerror="this.src='https://via.placeholder.com/150';">
                                    <div class="card-body p-2 text-center">
                                        <h6 class="card-title text-truncate" style="font-size: 0.9rem;" title="@sp.Name">@sp.Name</h6>
                                        <p class="text-danger fw-bold mb-2">@sp.Price.ToString("N0")đ</p>
                                        <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@sp.Id" class="btn btn-outline-primary btn-sm w-100">Mua ngay</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Cột phải: Tóm tắt đơn hàng & Mã giảm giá -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light py-3 border-bottom-0">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-ticket-perforated me-2"></i>Mã khuyến mãi</h5>
                    </div>
                    <div class="card-body p-3">
                        <div class="input-group">
                            <input type="text" id="couponCode" class="form-control" placeholder="Nhập mã (VD: GIAM10K)">
                            <button class="btn btn-dark" type="button" id="btnApplyCoupon">Áp dụng</button>
                        </div>
                        <small id="couponMessage" class="form-text mt-2 d-block"></small>
                    </div>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light py-3 border-bottom-0">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-receipt me-2"></i>Tóm tắt đơn hàng</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Tổng tiền hàng:</span>
                            <strong class="text-dark" id="summary-subtotal">@subtotal.ToString("N0")đ</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <strong class="text-dark">Giao Online (Miễn phí)</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Giảm giá:</span>
                            <strong class="text-success" id="summary-discount">-@discountAmount.ToString("N0")đ</strong>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="fw-bold fs-5">Tổng thanh toán:</span>
                            <strong class="text-danger fs-3" id="summary-total">@total.ToString("N0")đ</strong>
                        </div>
                        <a asp-controller="Cart" asp-action="Checkout" class="btn btn-primary fw-bold w-100 py-3 fs-5">
                            <i class="bi bi-credit-card me-2"></i> Thanh toán ngay
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            
            // Xử lý nút tăng giảm số lượng
            $('.btn-increase, .btn-decrease').click(function () {
                var btn = $(this);
                var productId = btn.data('id');
                var input = btn.siblings('.input-quantity');
                var currentQty = parseInt(input.val());
                var newQty = btn.hasClass('btn-increase') ? currentQty + 1 : currentQty - 1;

                if (newQty < 1) return; // Không cho giảm dưới 1 bằng nút này (nếu xóa thì bấm nút xóa)

                // Gọi AJAX cập nhật
                $.post('/Cart/UpdateQuantity', { id: productId, quantity: newQty }, function (res) {
                    if (res.success) {
                        input.val(newQty);
                        // Cập nhật UI tiền
                        $('#item-total-' + productId).text(res.itemTotal.toLocaleString('vi-VN') + 'đ');
                        updateSummaryUI(res.subtotal, res.total);
                    }
                });
            });

            // Xử lý nút áp dụng mã giảm giá
            $('#btnApplyCoupon').click(function() {
                var code = $('#couponCode').val().trim();
                var msgLabel = $('#couponMessage');
                
                if(!code) {
                    msgLabel.text("Vui lòng nhập mã giảm giá.").removeClass("text-success").addClass("text-danger");
                    return;
                }

                $.post('/Cart/ApplyCoupon', { code: code }, function(res) {
                    if(res.success) {
                        msgLabel.text(res.message).removeClass("text-danger").addClass("text-success");
                        $('#summary-discount').text('-' + res.discountAmount.toLocaleString('vi-VN') + 'đ');
                        updateSummaryUI(res.subtotal, res.total);
                        // Reload trang để cập nhật subtotal từ server nếu lười viết thêm JS :)
                        location.reload(); 
                    } else {
                        msgLabel.text(res.message).removeClass("text-success").addClass("text-danger");
                    }
                });
            });

            function updateSummaryUI(subtotal, total) {
                if(subtotal !== undefined) {
                    $('#summary-subtotal').text(subtotal.toLocaleString('vi-VN') + 'đ');
                }
                if(total !== undefined) {
                    $('#summary-total').text(total.toLocaleString('vi-VN') + 'đ');
                }
            }
        });
    </script>
}
