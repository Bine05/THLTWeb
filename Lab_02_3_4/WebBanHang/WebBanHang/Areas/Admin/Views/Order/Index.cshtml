@model IEnumerable<WebBanHang.Models.Order>

@{
    ViewData["Title"] = "Quản lý Đơn Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentStatus = ViewBag.CurrentStatus as string ?? "all";
}

<div class="container mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h2 class="fw-bold"><i class="bi bi-box-seam me-2"></i>Quản lý đơn hàng</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="ExportToCSV" class="btn btn-success fw-bold shadow-sm">
                <i class="bi bi-file-earmark-excel me-1"></i> Xuất CSV
            </a>
        </div>
    </div>

    <!-- Bộ lọc trạng thái -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light">
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Index" asp-route-status="all" class="btn @(currentStatus == "all" ? "btn-primary" : "btn-outline-secondary")">Tất cả</a>
                <a asp-action="Index" asp-route-status="Đã xác nhận" class="btn @(currentStatus == "Đã xác nhận" ? "btn-primary" : "btn-outline-secondary")">Đã xác nhận</a>
                <a asp-action="Index" asp-route-status="Đang chuẩn bị Acc" class="btn @(currentStatus == "Đang chuẩn bị Acc" ? "btn-primary" : "btn-outline-secondary")">Đang chuẩn bị Acc</a>
                <a asp-action="Index" asp-route-status="Đã gửi qua Email" class="btn @(currentStatus == "Đã gửi qua Email" ? "btn-primary" : "btn-outline-secondary")">Đã gửi qua Email</a>
                <a asp-action="Index" asp-route-status="Hoàn thành" class="btn @(currentStatus == "Hoàn thành" ? "btn-primary" : "btn-outline-secondary")">Hoàn thành</a>
                <a asp-action="Index" asp-route-status="Đã hủy" class="btn @(currentStatus == "Đã hủy" ? "btn-danger" : "btn-outline-danger")">Đã hủy</a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Mã ĐH</th>
                            <th>Khách Hàng</th>
                            <th>Ngày Đặt</th>
                            <th>Tổng Tiền</th>
                            <th>Trạng Thái</th>
                            <th class="text-center pe-3">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Không tìm thấy đơn hàng nào.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">#@item.Id</td>
                                <td>
                                    <h6 class="mb-0">@item.CustomerName</h6>
                                    <small class="text-muted"><i class="bi bi-envelope"></i> @item.Email</small>
                                </td>
                                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-danger fw-bold">@item.TotalAmount.ToString("N0") đ</td>
                                <td>
                                    <!-- Form Cập nhật trạng thái trực tiếp -->
                                    <form asp-action="UpdateStatus" method="post" class="d-flex align-items-center">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <select name="newStatus" class="form-select form-select-sm shadow-none border-secondary" style="width: 160px; font-size: 0.85rem;" onchange="this.form.submit()">
                                            <option value="Đã xác nhận" selected="@(item.OrderStatus == "Đã xác nhận")">Đã xác nhận</option>
                                            <option value="Đang chuẩn bị Acc" selected="@(item.OrderStatus == "Đang chuẩn bị Acc")">Đang chuẩn bị Acc</option>
                                            <option value="Đã gửi qua Email" selected="@(item.OrderStatus == "Đã gửi qua Email")">Đã gửi qua Email</option>
                                            <option value="Hoàn thành" selected="@(item.OrderStatus == "Hoàn thành")">Hoàn thành</option>
                                            <option value="Đã hủy" selected="@(item.OrderStatus == "Đã hủy")">Đã hủy</option>
                                        </select>
                                    </form>
                                </td>
                                <td class="text-center pe-3">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
