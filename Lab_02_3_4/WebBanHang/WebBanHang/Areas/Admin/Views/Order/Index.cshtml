@model IEnumerable<WebBanHang.Models.Order>

@{
    ViewData["Title"] = "Quản lý Đơn Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h2>Quản lý đơn hàng</h2>
        </div>
        <div class="col-md-6 text-end">
            <div class="alert alert-success d-inline-block m-0 p-3 shadow-sm border-0 rounded-3">
                <strong class="fs-5">Tổng Doanh Thu Hệ Thống:</strong>
                <span class="fs-4 text-danger fw-bold ms-2">@String.Format("{0:N0} đ", ViewBag.TotalRevenue)</span>
            </div>
        </div>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Mã ĐH</th>
                <th>Khách Hàng</th>
                <th>SĐT</th>
                <th>Email</th>
                <th>Ngày Đặt</th>
                <th>Tổng Tiền</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.CustomerName</td>
                    <td>@item.PhoneNumber</td>
                    <td>@item.Email</td>
                    <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-danger fw-bold">@String.Format("{0:N0} đ", item.TotalAmount)</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white">Xem chi tiết</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
