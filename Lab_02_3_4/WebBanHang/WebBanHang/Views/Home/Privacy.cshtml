@{
    ViewData["Title"] = "Chính Sách Bán Hàng & Bảo Mật";
}

<div class="container py-2">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary text-uppercase">@ViewData["Title"]</h2>
        <p class="text-muted">Mua bán acc Liên Quân uy tín, chất lượng, bảo hành vĩnh viễn cùng BINESHOP</p>
    </div>

    <div class="row g-4">
        <!-- Item 1 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 hover-shadow transition">
                <div class="mb-3">
                    <i class="bi bi-shield-check text-primary" style="font-size: 2.5rem;"></i>
                </div>
                <h5 class="fw-bold">Acc chính chủ 100%</h5>
                <p class="text-muted mb-0">Cam kết tất cả acc đều chính chủ, thông tin rõ ràng, không dính report, không tranh chấp.</p>
            </div>
        </div>
        
        <!-- Item 2 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 hover-shadow transition">
                <div class="mb-3">
                    <i class="bi bi-lightning-charge text-primary" style="font-size: 2.5rem;"></i>
                </div>
                <h5 class="fw-bold">Giao acc siêu tốc</h5>
                <p class="text-muted mb-0">Bàn giao thông tin acc ngay sau khi thanh toán thành công, nhanh chóng trong vòng vài phút.</p>
            </div>
        </div>

        <!-- Item 3 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 hover-shadow transition">
                <div class="mb-3">
                    <i class="bi bi-credit-card text-primary" style="font-size: 2.5rem;"></i>
                </div>
                <h5 class="fw-bold">Thanh toán đa dạng</h5>
                <p class="text-muted mb-0">Hỗ trợ chuyển khoản ngân hàng, ví MoMo, ZaloPay, VNPAY nhanh chóng và an toàn.</p>
            </div>
        </div>

        <!-- Item 4 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 hover-shadow transition">
                <div class="mb-3">
                    <i class="bi bi-lock text-primary" style="font-size: 2.5rem;"></i>
                </div>
                <h5 class="fw-bold">Bảo mật tuyệt đối</h5>
                <p class="text-muted mb-0">Thông tin acc và thông tin khách hàng được bảo mật hoàn toàn, không chia sẻ cho bên thứ ba dưới mọi hình thức.</p>
            </div>
        </div>

        <!-- Item 5 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 hover-shadow transition">
                <div class="mb-3">
                    <i class="bi bi-headset text-primary" style="font-size: 2.5rem;"></i>
                </div>
                <h5 class="fw-bold">Hỗ trợ 24/7</h5>
                <p class="text-muted mb-0">Đội ngũ hỗ trợ trực tuyến 24/7 qua Facebook, Zalo, sẵn sàng giải đáp mọi thắc mắc của bạn.</p>
            </div>
        </div>

        <!-- Item 6 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 hover-shadow transition">
                <div class="mb-3">
                    <i class="bi bi-patch-check text-primary" style="font-size: 2.5rem;"></i>
                </div>
                <h5 class="fw-bold">Bảo hành vĩnh viễn</h5>
                <p class="text-muted mb-0">Tất cả acc bán ra đều được bảo hành vĩnh viễn. Nếu bị lấy lại, BINESHOP cam kết đổi acc mới tương đương.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
    .transition {
        transition: all 0.3s ease;
    }
</style>
